# Review-only Deployment settings: shrunken resources, params ConfigMap into
# the app env, mail sink, review Sentry environment, noindex.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name }}
spec:
  template:
    spec:
      containers:
        - name: {{ app_name }}
          envFrom:
            - configMapRef:
                name: review-params
          env:
            # Mail NEVER leaves a review environment: the sink is structural,
            # not a policy. SMTP credential secrets must not be copied in.
            - name: SMTP_HOST
              value: mailpit.email.svc.cluster.local
            - name: SMTP_PORT
              value: "1025"
            - name: SENTRY_ENVIRONMENT
              value: review
            - name: DEPLOYMENT_ENV
              value: review
          resources:
            requests:
              cpu: 25m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 512Mi
