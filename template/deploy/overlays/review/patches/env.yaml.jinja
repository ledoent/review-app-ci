# Review-only Deployment settings: shrunken resources, params ConfigMap into
# the app env, mail sink, review Sentry environment, noindex.
#
# ASSUMES the base Deployment's container is named "{{ app_name }}" —
# strategic merge keys containers by name, and a mismatch ADDS a second,
# image-less container instead of patching. If the base names its container
# differently, fix the name below after the first stamp.
#
# Env entries merge FIELD-BY-FIELD by name: when switching a var between
# `value` and `valueFrom`, set the other field to null explicitly or the
# merged EnvVar carries both and the API server rejects the Deployment.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name }}
spec:
  template:
    spec:
      containers:
        - name: {{ app_name }}
          envFrom:
            - configMapRef:
                name: review-params
          env:
            # Mail NEVER leaves a review environment: the sink is structural,
            # not a policy. SMTP credential secrets must not be copied in.
            - name: SMTP_HOST
              value: mailpit.email.svc.cluster.local
            - name: SMTP_PORT
              value: "1025"
            - name: SENTRY_ENVIRONMENT
              value: review
            - name: DEPLOYMENT_ENV
              value: review
          resources:
            requests:
              cpu: 25m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 512Mi
