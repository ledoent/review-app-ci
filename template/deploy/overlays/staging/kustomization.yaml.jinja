apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Hand-owned after the first stamp (_skip_if_exists) — copier never overwrites.
namespace: {{ app_name }}-staging

resources:
  - ../../base

patches:
  - patch: |-
      - op: replace
        path: /spec/rules/0/host
        value: {{ staging_host | default(app_name ~ '-staging.' ~ review_domain) }}
    target:
      kind: Ingress
      name: {{ app_name }}

images:
  - name: {{ image_ref }}
    newTag: latest  # overwritten by CI
